generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         UserRole @default(SHOPKEEPER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shop         Shop?
  passwordResetTokens PasswordResetToken[]

  @@index([role])
}

/** Single-use password reset tokens — store hash only, never the raw token. */
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Shop {
  id                     String        @id @default(uuid())
  shopCode               String        @unique @db.VarChar(64)
  shopName               String        @db.VarChar(255)
  phone                  String        @db.VarChar(32)
  email                  String?       @db.VarChar(255)
  address                String        @db.Text
  logo                   String?       @db.Text
  isActive               Boolean       @default(true)
  ownerId                String?       @unique
  agentId                String?       @db.VarChar(128)
  agentTokenHash         String?       @db.VarChar(128)
  agentLastSeen          DateTime?
  agentPairingTokenHash  String?       @db.VarChar(128)
  agentPairingExpiresAt  DateTime?
  agentPairingUsedAt     DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  owner                  User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  inventory              Inventory?
  printJobs              PrintJob[]
  printPrice             PrintPrice?
  printers               Printer[]
  settings               Settings?
  subscription           Subscription?
  billingPayments        BillingPayment[]
  /**
   * Feature 2 — multi-device Agent credentials (Phase 2B.1+).
   * Pairing registration writes AgentDevice rows; Shop.agent* remains the legacy shim.
   */
  agentDevices           AgentDevice[]

  @@index([agentId])
  @@index([agentPairingTokenHash])
}

/**
 * Feature 2 — multi-device Agent credential row.
 * Phase 2B.1: pairing registration upserts this table; auth prefers tokenHash here,
 * then falls back to Shop.agentTokenHash. tokenHash is SHA-256 hex only.
 */
model AgentDevice {
  id          String     @id @default(uuid())
  shopId      String
  agentId     String     @db.VarChar(128)
  tokenHash   String     @db.VarChar(128)
  lastSeen    DateTime?
  /**
   * Feature 2 Phase 2C.3 — device-local default printer (AgentDevice auth).
   * Source of truth for device-authenticated Agents.
   * Legacy Shop-token Agents continue to use Printer.isDefault (shop-wide).
   */
  localDefaultPrinterId String?  @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  shop        Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  claimedJobs PrintJob[]
  printers    Printer[]  @relation("PrinterOwnedByAgentDevice")
  localDefaultPrinter Printer? @relation("AgentDeviceLocalDefault", fields: [localDefaultPrinterId], references: [id], onDelete: SetNull)

  @@unique([shopId, agentId])
  @@index([shopId])
  @@index([tokenHash])
}

model PrintPrice {
  id            String   @id @default(uuid())
  shopId        String   @unique
  /// B&W single-side rate per page (INR). New shops default to ₹5.00.
  bwSingle      Decimal  @db.Decimal(10, 2)
  bwDouble      Decimal  @db.Decimal(10, 2)
  colorSingle   Decimal  @db.Decimal(10, 2)
  colorDouble   Decimal  @db.Decimal(10, 2)
  minimumCharge Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Printer {
  id             String    @id @default(uuid())
  shopId         String
  /**
   * Feature 2 Phase 2C.2 — AgentDevice ownership for device-authenticated Agents.
   * Null = legacy shop-token Agent rows (shop-scoped upsert).
   * When set, must belong to the same Shop as shopId (enforced in upsert).
   */
  agentDeviceId  String?
  printerName    String    @db.VarChar(255)
  printerModel   String?   @db.VarChar(255)
  printerType    String?   @db.VarChar(64)
  /**
   * Shop-wide default — authoritative only for legacy Shop-token Agents.
   * AgentDevice auth uses AgentDevice.localDefaultPrinterId instead.
   */
  isDefault      Boolean   @default(false)
  /** Manual shopkeeper setting — never auto-detected. Default false = safe (no Color UI later). */
  colorSupported Boolean   @default(false)
  status         String    @default("offline") @db.VarChar(64)
  lastSeen       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  shop            Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  agentDevice     AgentDevice? @relation("PrinterOwnedByAgentDevice", fields: [agentDeviceId], references: [id], onDelete: SetNull)
  localDefaultFor AgentDevice[] @relation("AgentDeviceLocalDefault")

  // Phase 2C.2: device-scoped identity. Shop-level (shopId, printerName) unique
  // was dropped so Agent A and Agent B may both own "Canon" in the same Shop.
  @@unique([agentDeviceId, printerName])
  @@index([shopId])
  @@index([shopId, printerName])
  @@index([agentDeviceId])
}

model Inventory {
  id                String   @id @default(uuid())
  shopId            String   @unique
  paperAvailable    Int      @default(0)
  estimatedInkLevel Int      @default(100)
  updatedAt         DateTime @updatedAt
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model PrintJob {
  id            String         @id @default(uuid())
  shopId        String
  jobSequence   Int
  jobNumber     String         @db.VarChar(64)
  copies        Int            @default(1)
  totalPages    Int
  printMode     PrintMode
  printType     PrintType
  totalPrice    Decimal        @db.Decimal(10, 2)
  /**
   * Versioned print instructions (nullable JSON).
   * null = legacy job — Agent must use today's exact print behavior.
   * See shared/print-settings.ts for the v1 shape. Not a pricing source of truth;
   * PrintJob.copies remains canonical for billing/pricing.
   */
  printSettings Json?
  status        PrintStatus    @default(PENDING)
  printAttempts Int            @default(0)
  lastError     String?        @db.Text
  /**
   * Feature 2 Phase 2E — AgentDevice claim ownership while PRINTING.
   * Set atomically on PENDING → PRINTING for device-authenticated Agents.
   * Cleared when released/recovered to PENDING. Retained on COMPLETED/FAILED for history.
   * Legacy Shop-token claims may leave claimedByAgentDeviceId NULL.
   */
  claimedByAgentDeviceId String?
  claimedAt              DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  claimedByAgentDevice AgentDevice? @relation(fields: [claimedByAgentDeviceId], references: [id], onDelete: SetNull)
  files         PrintJobFile[]

  @@unique([shopId, jobSequence])
  @@unique([shopId, jobNumber])
  @@index([status])
  @@index([createdAt])
  @@index([shopId])
  @@index([shopId, status])
  @@index([claimedByAgentDeviceId])
}

model PrintJobFile {
  id               String    @id @default(uuid())
  printJobId       String
  originalFileName String    @db.VarChar(500)
  storedFileName   String    @db.VarChar(255)
  fileExtension    String    @db.VarChar(32)
  fileSize         Int
  totalPages       Int
  printedAt        DateTime?
  fileDeletedAt    DateTime?
  createdAt        DateTime  @default(now())
  printJob         PrintJob  @relation(fields: [printJobId], references: [id], onDelete: Cascade)

  @@index([printJobId])
}

model Settings {
  id             String   @id @default(uuid())
  shopId         String   @unique
  currency       String   @default("INR") @db.VarChar(16)
  timezone       String   @default("Asia/Kolkata") @db.VarChar(64)
  autoDeleteDays Int      @default(7)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

/**
 * Shop SaaS subscription (source of truth for access).
 * Cashfree is the external provider; provider IDs are set in Phase 4C.
 */
model Subscription {
  id                     String             @id @default(uuid())
  shopId                 String             @unique
  plan                   SubscriptionPlan   @default(TRIAL)
  status                 SubscriptionStatus @default(TRIALING)
  trialStartAt           DateTime?
  trialEndAt             DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  cancelledAt            DateTime?
  pastDueSince           DateTime?
  provider               String?            @db.VarChar(64)
  providerCustomerId     String?            @db.VarChar(128)
  providerSubscriptionId String?            @db.VarChar(128)
  providerPlanId         String?            @db.VarChar(128)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  shop                   Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([trialEndAt])
  @@index([providerSubscriptionId])
}

/**
 * Shopkeeper SaaS payment ledger (not customer print payments).
 * Entitlement/access remains on Subscription — this records verified charges.
 */
model BillingPayment {
  id                 String   @id @default(uuid())
  shopId             String
  provider           String   @db.VarChar(64)
  mode               String   @db.VarChar(32)
  status             String   @db.VarChar(32)
  amountInr          Int
  currency           String   @default("INR") @db.VarChar(16)
  providerOrderId    String   @db.VarChar(128)
  providerPaymentId  String?  @db.VarChar(128)
  periodStart        DateTime?
  periodEnd          DateTime?
  paidAt             DateTime?
  failureReason      String?  @db.VarChar(500)
  metadataJson       String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([provider, providerOrderId])
  @@index([shopId])
  @@index([status])
  @@index([providerPaymentId])
  @@index([createdAt])
}

/**
 * Idempotent Cashfree (and future provider) webhook receipts.
 * Unique on (provider, eventId) so duplicate deliveries are ignored.
 */
model PaymentWebhookEvent {
  id          String    @id @default(uuid())
  provider    String    @db.VarChar(64)
  eventId     String    @db.VarChar(191)
  eventType   String    @db.VarChar(128)
  payloadHash String    @db.VarChar(128)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([eventType])
}

enum UserRole {
  SHOPKEEPER
  ADMIN
}

enum PrintMode {
  BW
  COLOR
}

enum PrintType {
  SINGLE
  DOUBLE
}

enum PrintStatus {
  PENDING
  PRINTING
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
}

enum SubscriptionPlan {
  TRIAL
  PREMIUM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}
