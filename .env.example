# App (browser-safe)
NEXT_PUBLIC_APP_NAME="PrintYantra"
# Public site URL used for QR codes (LAN IP locally, HTTPS domain in production)
NEXT_PUBLIC_APP_URL="https://YOUR-DOMAIN.com"

# Database (MySQL / MariaDB) — server only, never NEXT_PUBLIC_
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# Shopkeeper auth JWT — server only
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Gmail SMTP for password-reset emails — server only, never NEXT_PUBLIC_
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# SMTP auth user AND password-reset From address (see lib/mail.ts).
# Production target: support@printyantra.com (mailbox must be allowed by your SMTP provider).
SMTP_USER=support@printyantra.com
# Gmail App Password only (not your normal Gmail password). Leave empty locally until configured.
SMTP_PASSWORD=

# Agent registration secret — required in production.
# Print Agent must send this when calling POST /api/print-agent/register
# Header: X-Agent-Setup-Secret: <value>
# or JSON body field: setupSecret
AGENT_SETUP_SECRET="change-this-long-random-agent-setup-secret"

# Max Agent devices (AgentDevice / agentId) allowed per shop — server only.
# Same agentId reconnect/relogin does not consume an extra slot.
# Missing/empty → default 2. Invalid values (0, negative, non-numeric) are rejected
# and fall back to 2 (never raise the limit from garbage input).
MULTI_DEVICE_LIMIT=2

# Cashfree Subscriptions / Payment Gateway (server-only — never NEXT_PUBLIC_)
# Create keys in Cashfree Merchant Dashboard → Developers → API Keys
CASHFREE_CLIENT_ID="your_cashfree_client_id"
CASHFREE_CLIENT_SECRET="your_cashfree_client_secret"
# sandbox | production
CASHFREE_ENVIRONMENT="sandbox"
# Optional: pre-created Cashfree plan_id. If unset, a PERIODIC ₹199/month plan is sent inline.
# If set, the Cashfree dashboard plan amount must also be ₹199/month.
# CASHFREE_PLAN_ID="pme_premium_199"
# Optional webhook secret (defaults to CASHFREE_CLIENT_SECRET if unset)
# CASHFREE_WEBHOOK_SECRET="your_cashfree_webhook_secret"

# Billing mode (server-only). one_time = manual monthly pay (Cashfree PG or PayU).
# subscription = Cashfree Subscriptions recurring (legacy; Cashfree only).
BILLING_PROVIDER=cashfree
# BILLING_PROVIDER=payu
BILLING_MODE=one_time

# PayU one-time hosted checkout (server-only — never NEXT_PUBLIC_).
# Only used when BILLING_PROVIDER=payu. Leave empty while Cashfree is active.
# PAYU_ENVIRONMENT=test
# PAYU_MERCHANT_KEY=
# PAYU_MERCHANT_SECRET=
# Webhook URL (form-urlencoded): https://YOUR-DOMAIN.com/api/webhooks/payu

# File uploads — server only
UPLOAD_DIR="storage/uploads"
MAX_UPLOAD_SIZE_MB="20"

# Windows Agent installer (server-only). Must be readable by the Node process.
# Filename must be PrintYantra-Agent-Setup-1.5.1.exe. Do not use NEXT_PUBLIC_.
# Example (Hostinger persistent location, if the Node runtime can read it):
# WINDOWS_AGENT_FILE_PATH="/home/USER/domains/printyantra.com/agent-files/PrintYantra-Agent-Setup-1.5.1.exe"
# WINDOWS_AGENT_FILE_PATH=
#
# Optional lowercase hex SHA-256 of that same EXE (for GET /api/agent/update).
# After building: cd print-agent && npm run dist && npm run release:hash — copy printed values.
# Leave unset until the 1.5.1 installer is built and hashed. Do not invent a value.
# WINDOWS_AGENT_SHA256=

# Set to "true" only when intentionally seeding the local demo shop PME001.
# Never enable this on production Hostinger unless intentional.
# ALLOW_DEMO_SEED="true"

# Optional one-time claim of PME001 (used by prisma seed / scripts/claim-pme001.ts)
# CLAIM_DEMO_SHOP_EMAIL="you@example.com"
# CLAIM_DEMO_SHOP_PASSWORD="choose-a-strong-password"
