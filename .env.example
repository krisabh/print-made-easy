# App
NEXT_PUBLIC_APP_NAME="Print Made Easy"
NEXT_PUBLIC_APP_URL="http://YOUR_LAN_IP:3000"

# Database (MySQL / MariaDB)
# Example: mysql://root:YOUR_PASSWORD@127.0.0.1:3306/printmadeeasy
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/printmadeeasy"

# JWT Authentication
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# File uploads
UPLOAD_DIR="storage/uploads"
MAX_UPLOAD_SIZE_MB="20"
