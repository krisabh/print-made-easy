# App
NEXT_PUBLIC_APP_NAME="Print Made Easy"
NEXT_PUBLIC_APP_URL="http://YOUR_LAN_IP:3000"

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/printmadeeasy?schema=public"

# JWT Authentication
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# File uploads
UPLOAD_DIR="storage/uploads"
MAX_UPLOAD_SIZE_MB="20"
