# App (browser-safe)
NEXT_PUBLIC_APP_NAME="Print Made Easy"
# Public site URL used for QR codes (LAN IP locally, HTTPS domain in production)
NEXT_PUBLIC_APP_URL="https://YOUR-DOMAIN.com"

# Database (MySQL / MariaDB) — server only, never NEXT_PUBLIC_
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"

# Shopkeeper auth JWT — server only
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Agent registration secret — required in production.
# Print Agent must send this when calling POST /api/print-agent/register
# Header: X-Agent-Setup-Secret: <value>
# or JSON body field: setupSecret
AGENT_SETUP_SECRET="change-this-long-random-agent-setup-secret"

# Cashfree Subscriptions (server-only — never NEXT_PUBLIC_)
# Create keys in Cashfree Merchant Dashboard → Developers → API Keys
CASHFREE_CLIENT_ID="your_cashfree_client_id"
CASHFREE_CLIENT_SECRET="your_cashfree_client_secret"
# sandbox | production
CASHFREE_ENVIRONMENT="sandbox"
# Optional: pre-created Cashfree plan_id. If unset, a PERIODIC ₹499/month plan is sent inline.
# CASHFREE_PLAN_ID="pme_premium_499"
# Optional webhook secret (defaults to CASHFREE_CLIENT_SECRET if unset)
# CASHFREE_WEBHOOK_SECRET="your_cashfree_webhook_secret"

# File uploads — server only
UPLOAD_DIR="storage/uploads"
MAX_UPLOAD_SIZE_MB="20"

# Set to "true" only when intentionally seeding the local demo shop PME001.
# Never enable this on production Hostinger unless intentional.
# ALLOW_DEMO_SEED="true"

# Optional one-time claim of PME001 (used by prisma seed / scripts/claim-pme001.ts)
# CLAIM_DEMO_SHOP_EMAIL="you@example.com"
# CLAIM_DEMO_SHOP_PASSWORD="choose-a-strong-password"
