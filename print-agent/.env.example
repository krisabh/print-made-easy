# PrintMadeEasy Windows Print Agent

# Development only — packaged Windows installs do NOT ship or require this file.
# Packaged Agents default to https://clauras.com and pair via Dashboard connection link/QR.

# API base URL
# Local:  http://localhost:3000
# Prod:   https://clauras.com
PRINTMADEEASY_API_URL=http://localhost:3000
# API_URL is also accepted as an alias of PRINTMADEEASY_API_URL

# Optional development-only values. Packaged Windows installs ignore this file.
# Agent ID is a device identity (PMEA-WINDOWS-XXXXXXXX), not a shop code.
# AGENT_ID is used only in development when no persisted Agent ID exists yet.
# Do not set AGENT_ID from a shop code (e.g. PME2SRN2X-WINDOWS-01).
# SHOP_CODE=PME001
# AGENT_ID=agent-local-001
# AGENT_SETUP_SECRET=change-this-long-random-agent-setup-secret
