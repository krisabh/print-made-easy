{
  "name": "print-made-easy-agent",
  "version": "1.0.0",
  "private": true,
  "description": "PrintMadeEasy Windows Print Agent",
  "author": "PrintMadeEasy",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc && node scripts/copy-ui.js",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.printmadeeasy.agent",
    "productName": "PrintMadeEasy Agent",
    "copyright": "Copyright © PrintMadeEasy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/.env",
      "!**/.env.*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "PrintMadeEasy-Agent-Setup-${version}.${ext}",
      "executableName": "PrintMadeEasy Agent",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PrintMadeEasy Agent",
      "uninstallDisplayName": "PrintMadeEasy Agent",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdf-to-printer": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2"
  }
}
