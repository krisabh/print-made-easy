# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
!.env.example

# uploads (keep folder, ignore files)
/storage/uploads/*
!/storage/uploads/.gitkeep

# electron / print-agent
/electron/dist
/electron/out
/print-agent/node_modules
/print-agent/dist
/print-agent/release
/print-agent/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
