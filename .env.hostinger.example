# ============================================================
# Hostinger production environment — IMPORT THIS, THEN EDIT
# Replace every YOUR_* placeholder before clicking Finish
# ============================================================

# Public site URL (your real domain with https)
NEXT_PUBLIC_APP_NAME=PrintYantra
NEXT_PUBLIC_APP_URL=https://printyantra.com

# Hostinger MySQL (from hPanel → Databases → MySQL)
# Use 127.0.0.1 (not localhost) — Prisma needs TCP
# Format: mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_NAME
# If password has special characters, URL-encode them
# Password must be the MySQL user password (test login in phpMyAdmin)
DATABASE_URL=mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:3306/YOUR_DB_NAME

# Server secrets (generate long random strings — do not reuse local ones)
JWT_SECRET=YOUR_LONG_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=7d
AGENT_SETUP_SECRET=YOUR_LONG_RANDOM_AGENT_SETUP_SECRET

# Gmail SMTP for password-reset emails (server-only — never NEXT_PUBLIC_)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=clauras.ai@gmail.com
# Use a Gmail App Password. Do not commit the real value.
SMTP_PASSWORD=

# Cashfree Subscriptions (server-only)
# Start with sandbox keys. Switch CASHFREE_ENVIRONMENT=production only when ready.
CASHFREE_CLIENT_ID=YOUR_CASHFREE_CLIENT_ID
CASHFREE_CLIENT_SECRET=YOUR_CASHFREE_CLIENT_SECRET
CASHFREE_ENVIRONMENT=sandbox
# Optional:
# CASHFREE_PLAN_ID=YOUR_CASHFREE_PLAN_ID
# CASHFREE_WEBHOOK_SECRET=YOUR_CASHFREE_WEBHOOK_SECRET

# Billing (server-only). Production stays on Cashfree until PayU cutover.
# Do not set BILLING_PROVIDER=payu in production until Phase cutover.
BILLING_PROVIDER=cashfree
BILLING_MODE=one_time

# PayU (server-only) — unused while BILLING_PROVIDER=cashfree.
# PAYU_ENVIRONMENT=test
# PAYU_MERCHANT_KEY=
# PAYU_MERCHANT_SECRET=
# Webhook: https://printyantra.com/api/webhooks/payu

# Windows Agent installer (server-only). Must be readable by the Node process.
# Filename must be PrintYantra-Agent-Setup-1.5.1.exe. Do not use NEXT_PUBLIC_.
# Replace USER with the Hostinger account path; keep agent-files/ + exact filename.
# After `npm run dist` + `npm run release:hash` in print-agent/, copy the printed values.
WINDOWS_AGENT_FILE_PATH=/home/USER/domains/printyantra.com/agent-files/PrintYantra-Agent-Setup-1.5.1.exe
WINDOWS_AGENT_SHA256=

# Uploads (private folder on the server)
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=20

# Runtime
NODE_ENV=production

# Optional one-time claim of existing PME001 (do not set permanently):
# ALLOW_DEMO_SEED=true
# CLAIM_DEMO_SHOP_EMAIL=you@example.com
# CLAIM_DEMO_SHOP_PASSWORD=choose-a-strong-password
